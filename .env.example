# --- eMajlis API — variables d'environnement ---------------------------------
PORT=3000
NODE_ENV=production

# HumHub (API REST v1)
HUMHUB_BASE_URL=https://emajlis.csefrs.ma
HUMHUB_TIMEOUT_MS=30000

# WordPress de l'intranet (Journal, revues de presse)
WP_BASE_URL=https://intranet.csefrs.ma
# L'intranet exige une connexion : compte en lecture seule + mot de passe d'application
# (WordPress → Profil → Mots de passe d'application).
WP_USER=
WP_APP_PASSWORD=

# Adresse publique de cette API (sert aux liens de lecture des fichiers).
# Facultatif : déduite de la requête si absente.
PUBLIC_BASE_URL=https://backendemajliss-production.up.railway.app

# Notifications push (Expo)
# Clé de chiffrement des inscriptions sur disque — longue chaîne aléatoire.
PUSH_SECRET=
PUSH_POLL_SECONDS=60
# PUSH_ENABLED=0 pour désactiver l'envoi

# CORS : uniquement si un site web appelle l'API (l'application mobile n'en a pas besoin)
CORS_ORIGINS=

# Limites
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_MAX=50
MAX_FILE_SIZE_MB=10
ENRICH_CONCURRENCY=6

# Proxy HTML (domaines autorisés, séparés par des virgules)
PROXY_ALLOWED_HOSTS=emajlis-info.csefrs.ma,emajlis-dev.csefrs.ma,emajlis.csefrs.ma,www.csefrs.ma,csefrs.ma
